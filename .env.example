# ═══════════════════════════════════════════════════════════════════
# .env.example — CrimeScope Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────────
APP_NAME=CrimeScope
ENVIRONMENT=development         # development | production
DEBUG=True                      # Set to False in production
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# ── URLs ─────────────────────────────────────────────────────────────
# Local development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Railway deployment (replace with your actual Railway subdomains)
# BACKEND_URL=https://<your-backend>.up.railway.app
# FRONTEND_URL=https://<your-frontend>.up.railway.app

# ── Database ─────────────────────────────────────────────────────────
# Local (Docker Compose)
DATABASE_URL=postgresql+asyncpg://crimescope:crimescope@postgres:5432/crimescope
# Railway (copy from Railway dashboard → Postgres service → Variables)
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@<host>:5432/railway

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# Railway: REDIS_URL=redis://default:<password>@<host>:6379

# ── Auth ─────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match EXACTLY what's registered in Google Cloud Console
# Local:    http://localhost:3000/api/auth/callback/google
# Railway:  https://<your-frontend>.up.railway.app/api/auth/callback/google
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ── Stripe ───────────────────────────────────────────────────────────
# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
# Local webhook: stripe listen --forward-to localhost:8000/api/v1/payments/webhook

# ── Email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=re_...
# onboarding@resend.dev works without domain verification (sandbox only)
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=CrimeScope
# Dev override: redirect all emails to your own verified Resend address
# EMAIL_TO_OVERRIDE=your@gmail.com

# ── City Data APIs ────────────────────────────────────────────────────
CHICAGO_API_TOKEN=
NYC_API_TOKEN=
LA_API_TOKEN=

# ── Monitoring ────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Mapbox ────────────────────────────────────────────────────────────
MAPBOX_TOKEN=

# ═══════════════════════════════════════════════════════════════════
# FRONTEND (prefix NEXT_PUBLIC_ for client-side access)
# Set these in Railway → Frontend service → Variables
# ═══════════════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://localhost:8000
# Railway: NEXT_PUBLIC_API_URL=https://<your-backend>.up.railway.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Railway: NEXT_PUBLIC_APP_URL=https://<your-frontend>.up.railway.app
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SALES_EMAIL=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_IN_PRODUCTION
